
<div class="modal-body" id="userSection">
    <p class="text-muted mb-3">Mevcut e-posta adresinize bir doğrulama kodu gönderdik. Kodu ve yeni e-posta adresinizi girin.</p>
    <form id="userForm">
        <div class="mb-3">
            <label class="form-label">Doğrulama Kodu</label>
            <input type="text" class="form-control" name="verificationCode" inputmode="numeric" maxlength="6" autocomplete="one-time-code" required>
        </div>
        <div class="mb-3">
            <label class="form-label">Yeni E-Posta</label>
            <input type="email" class="form-control" name="Email" required>
        </div>
        <button id="btnSaveEmail" type="submit" class="btn btn-success">Kaydet</button>
    </form>
    <!-- Geri sayım göstergesi -->
    <div class="mb-2 text-muted mt-3">
        Kalan süre: <span id="countdownTimer">03:00</span>
    </div>
</div>

<script>
    let otpInterval = null;
    const otpTimeout = 3 * 60 * 1000; // api'deki kod geçerlilik süresiyle aynı (3 dakika)

    // Zamanlayıcı başlatma fonksiyonu; süre dolunca kaydet butonu kapanır
    function startOtpTimer() {
        const countdownEl = $("#countdownTimer");
        const otpStartTime = new Date().getTime();

        if (otpInterval) clearInterval(otpInterval);

        otpInterval = setInterval(function () {
            const remaining = otpTimeout - (new Date().getTime() - otpStartTime);

            if (remaining <= 0) {
                clearInterval(otpInterval);
                countdownEl.text("00:00");
                $("#btnSaveEmail").prop("disabled", true);
                alert("Kodun süresi doldu. Lütfen yeniden kod isteyin.");
                return;
            }

            const minutes = Math.floor((remaining / 1000) / 60);
            const seconds = Math.floor((remaining / 1000) % 60);
            countdownEl.text(
                `${minutes.toString().padStart(2, "0")}:${seconds.toString().padStart(2, "0")}`
            );
        }, 1000);
    }

    // Modal açıldığında zaman başlasın
    $(document).off('shown.bs.modal.otp').on('shown.bs.modal.otp', '#myModal', function () {
        $("#btnSaveEmail").prop("disabled", false);
        startOtpTimer();
    });

    // Modal kapandığında sıfırla
    $(document).off('hidden.bs.modal.otp').on('hidden.bs.modal.otp', '#myModal', function () {
        clearInterval(otpInterval);
    });
</script>
