@model ECOM.Models.CartViewModel

@section Styles {
    <link rel="stylesheet" href="~/css/cart.css">
    <link rel="stylesheet" href="~/css/main.css">
}

<div class="container cart-page">
    <!-- Cart Header Steps -->
    <div class="cart-header-bar">
        <div class="cart-steps">
            <div class="cart-step active">
                <span class="cart-step-num">1</span>
                <span>Sepetim</span>
            </div>
            <div class="cart-step-line"></div>
            <div class="cart-step">
                <span class="cart-step-num">2</span>
                <span>Adres</span>
            </div>
            <div class="cart-step-line"></div>
            <div class="cart-step">
                <span class="cart-step-num">3</span>
                <span>Ödeme</span>
            </div>
        </div>
    </div>

    @if (Model.Cart?.Products is null || Model.Cart.Products.Count == 0)
    {
        <!-- Empty Cart -->
        <div class="empty-cart-wrapper">
            <img src="~/img/cart.gif" alt="Boş Sepet">
            <h4>Sepetin şu an boş</h4>
            <p>Sepetini e-com'un fırsatlarla dolu dünyasından doldurmak için aşağıdaki ürünleri incelemeye başlayabilirsin.</p>
            <a asp-controller="Main" asp-action="Index" class="btn-primary-custom" style="margin-top:24px;">
                <i class="fas fa-arrow-left"></i> Alışverişe Devam Et
            </a>
        </div>

        @if (Model.Favorites is not null && Model.Favorites.Any())
        {
            <div class="suggestion-section">
                <h3 class="suggestion-title">
                    <i class="fas fa-heart" style="color:var(--danger); margin-right:8px;"></i>
                    Beğendiklerim
                </h3>
                <div class="products-grid">
                    @await Html.PartialAsync("Suggestion", Model.Favorites)
                </div>
            </div>
        }
    }
    else
    {
        <!-- Coupon Bar -->
        <div class="coupons-bar">
            <a asp-controller="Account" asp-action="Index" asp-route-id="coupon" class="coupon-link">
                <i class="fas fa-gift"></i>
                Kuponlarım
            </a>
            <a href="#" class="add-coupon-btn">
                Kupon Kodu Ekle <i class="fas fa-plus"></i>
            </a>
        </div>

        <!-- Cart Title -->
        <div class="cart-title">
            Sepetim
            <span class="cart-count-badge">@Model.Cart.Products.Count Ürün</span>
        </div>

        <!-- Cart Layout -->
        <div class="cart-layout">
            <!-- Orders -->
            <div class="orders-col">
                @foreach (var cart in Model.Cart.Products)
                {
                    @await Html.PartialAsync("Cart", cart)
                }
            </div>

            <!-- Cart Total -->
            @{
                // toplam fiyat api'de sadece seçili (enable) ürünlerden hesaplanır
                decimal cartSummaryPrice = Model.Cart.TotalPrice;
                int cartSummaryProductCount = Model.Cart.Products.Count(p => p.Enable);
            }

            <div class="cart-total-panel">
                <div class="cart-total-title">
                    <i class="fas fa-receipt" style="color:var(--primary); margin-right:8px;"></i>
                    Sipariş Özeti
                </div>

                <div class="cart-total-row">
                    <span>Seçilen Ürünler (<span id="summary-count">@cartSummaryProductCount</span>)</span>
                    <span id="summary-subtotal">₺@cartSummaryPrice.ToString("F2")</span>
                </div>
                <div class="cart-total-row">
                    <span>Kargo</span>
                    <span class="cargo-free"><i class="fas fa-check"></i> Bedava</span>
                </div>
                <div class="cart-total-row grand-total">
                    <span>Toplam</span>
                    <span class="amount" id="summary-total">₺@cartSummaryPrice.ToString("F2")</span>
                </div>

                <form asp-controller="Payment" asp-action="Index" method="post">
                    <input type="hidden" name="cart-total" id="summary-total-input" value="@cartSummaryPrice" />
                    <button type="submit" class="checkout-btn">
                        <i class="fas fa-lock"></i>
                        Alışverişi Tamamla
                    </button>
                </form>

                <div style="display:flex; align-items:center; gap:6px; color:var(--success); font-size:12.5px; font-weight:600; justify-content:center; margin-top:12px;">
                    <i class="fas fa-shield-alt"></i> 256-bit SSL ile güvenli ödeme
                </div>
            </div>
        </div>

        <!-- Favorites Suggestion -->
        @if (Model.Favorites is not null && Model.Favorites.Any())
        {
            <div class="suggestion-section" style="max-width: calc(100% - 344px);">
                <h3 class="suggestion-title">
                    <i class="fas fa-heart" style="color:var(--danger); margin-right:8px;"></i>
                    Beğendiklerim
                </h3>
                @await Html.PartialAsync("Suggestion", Model.Favorites)
            </div>
        }
    }
</div>

<script>
    // sepet satırlarının adet ve seçim değişiklikleri; satır başına değil sayfada bir kez bağlanır
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll('.order').forEach(order => {
            const checkbox = order.querySelector('.order-is-active');
            const countInput = order.querySelector('.order-count');

            // api adet ve seçili durumunu birlikte güncellediği için her değişiklikte ikisi de gönderilir
            const update = async function () {
                const piece = parseInt(countInput.value, 10);
                if (!piece || piece < 1) {
                    countInput.value = 1;
                    return;
                }

                const response = await fetch('/Cart/Update', {
                    method: 'POST',
                    // X-Requested-With: oturum düşmüşse cookie auth login html'i yerine 401 döner
                    headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                    body: JSON.stringify({
                        productId: parseInt(order.dataset.productId, 10),
                        sellerId: parseInt(order.dataset.sellerId, 10),
                        piece: piece,
                        enable: checkbox.checked
                    })
                });

                if (response.status === 401) {
                    window.location.href = '/Login/Index?ReturnUrl=' + encodeURIComponent('/Cart/Index');
                    return;
                }

                const data = await response.json().catch(() => ({}));
                if (!response.ok) {
                    alert(data.message ?? "Sepet güncellenemedi.");
                    return;
                }

                if (data.itemPrice)
                    order.querySelector('.price').textContent = `₺${data.itemPrice}`;

                updateCartSummaryDisplay(data.totalPrice, data.count);
            };

            checkbox.addEventListener('change', update);
            countInput.addEventListener('change', update);
        });
    });

    function updateCartSummaryDisplay(totalPrice, count) {
        document.getElementById('summary-count').textContent = count;
        document.getElementById('summary-subtotal').textContent = `₺${totalPrice}`;
        document.getElementById('summary-total').textContent = `₺${totalPrice}`;
        document.getElementById('summary-total-input').value = totalPrice;
    }
</script>
