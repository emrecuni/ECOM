@model ECOM.Shared.Data.DTOs.Product.ProductOfCartDto

@* sepet satırı api'de ürün + satıcı ile tanımlanır; güncelleme script'i Cart/Index.cshtml içinde, her satır için tekrar yüklenmesin diye *@
<div class="order" data-product-id="@Model.Id" data-seller-id="@Model.SellerId">
    <div class="order-header d-flex justify-content-between align-items-center">
        <span class="saler">Satıcı: <b>@Model.SellerName</b></span>
        <span class="cargo-desc"><b>Kargo Bedava</b></span>
    </div>
    <hr />
    <div class="order-body">
        <input type="checkbox" name="order-is-active" class="order-is-active" @(Model.Enable ? "checked" : "") />
        <img src="~/@Model.ImagePath" alt="Ürün" class="product-image" />
        <div class="order-info">
            <span class="order-name"><b><a asp-controller="Product" asp-action="Index" asp-route-id="@Model.Id">@Model.Name</a></b></span>
            <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 8px;">
            <input type="number" name="order-count" class="order-count"
                   value="@Model.Piece" min="1" />

            <span class="price">₺@Model.Price.ToString("F2")</span>
            </div>
        </div>
    </div>
</div>
